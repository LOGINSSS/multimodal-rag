# 复制本文件为 .env 并填入真实 key：  cp .env.example .env
# .env 已加入 .gitignore，不会提交。

# ---------- 模型 API key ----------

# DeepSeek（R1 做 query 重构 + deepseek-chat 做 HyDE）
# 获取：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 阿里 DashScope（embedding + Qwen-VL 生成 + rerank 精排）
# 获取：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---------- Milvus 向量库 ----------

MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=rag_chunks
# DashScope text-embedding-v3 默认维度是 1024
DENSE_DIM=1024

# ---------- 模型名（一般不用改） ----------

DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_CHAT_MODEL=deepseek-chat
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
QWEN_VL_MODEL=qwen-vl-max
RERANK_MODEL=gte-rerank-v2

# ---------- 可选：LangFuse 观测 ----------
# 留空则不启用。自托管填 http://localhost:3000，云版填 https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---------- 可选：HuggingFace 国内镜像 ----------
# 下载 MinerU / CLIP / Qwen3-reranker 等模型权重时用
HF_ENDPOINT=https://hf-mirror.com
